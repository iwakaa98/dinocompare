generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  name                 String
  passwordHash         String
  stripeCustomerId     String?        @unique
  stripeSubscriptionId String?
  plan                 String         @default("free")
  planStatus           String         @default("inactive")
  planCurrentPeriodEnd DateTime?
  searchQuotaMonth     Int            @default(0)
  createdAt            DateTime       @default(now())
  searches             SearchHistory[]
}

model SearchHistory {
  id          String   @id @default(cuid())
  query       String
  productSlug String?
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ProductStat {
  id           String   @id @default(cuid())
  query        String   @unique
  productSlug  String
  searchCount  Int      @default(1)
  lastSearched DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CatalogSnapshot {
  productSlug  String   @id
  searchQuery  String
  searchCount  Int      @default(0)
  bestTotal    Float?
  worstTotal   Float?
  savingsEur   Float?
  offerCount   Int      @default(0)
  refreshedAt  DateTime
}
