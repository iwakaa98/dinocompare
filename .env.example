# Local: docker compose up -d
# Railway: PostgreSQL plugin sets DATABASE_URL automatically
DATABASE_URL="postgresql://dentsravni:dentsravni@localhost:5432/dentsravni"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="change-me-in-production"
AUTH_TRUST_HOST="true"

# Stripe (EUR subscriptions)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_CLINIC="price_..."

# Railway cron: POST /api/catalog/refresh with Authorization: Bearer <secret>
CRON_SECRET="change-me-cron-secret"
